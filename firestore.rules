rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function productPath(pid) { return /databases/$(database)/documents/products/$(pid); }
    function orderPath(oid) { return /databases/$(database)/documents/orders/$(oid); }
    function isAdmin() {
      return signedIn() && get(userPath(request.auth.uid)).data.role == 'admin';
    }
    function canAccessOrderMessages(orderId) {
      return signedIn()
        && (isAdmin() || get(orderPath(orderId)).data.userId == request.auth.uid);
    }
    function validProfile() {
      return request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.suffix is string
        && request.resource.data.province is string
        && request.resource.data.province.size() > 0
        && request.resource.data.municipality is string
        && request.resource.data.municipality.size() > 0
        && request.resource.data.barangay is string
        && request.resource.data.barangay.size() > 0
        && request.resource.data.facebookName is string
        && request.resource.data.facebookName.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.role == 'user'
        && (
          (request.resource.data.keys().hasOnly(['firstName', 'lastName', 'suffix', 'province', 'municipality', 'barangay', 'facebookName', 'phone', 'email', 'role'])
            && request.resource.data.facebookName is string
            && request.resource.data.facebookName.size() > 0)
          || (request.resource.data.keys().hasOnly(['firstName', 'lastName', 'suffix', 'region', 'province', 'municipality', 'barangay', 'street', 'phone', 'email', 'role'])
            && request.resource.data.region is string
            && request.resource.data.street is string)
        );
    }
    function validProduct() {
      return request.resource.data.keys().hasOnly(['name', 'description', 'stock', 'price', 'saleType', 'imageUrl', 'promoStartDate', 'promoEndDate', 'active', 'lastOrderId'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.description is string
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.saleType in ['regular', 'promo']
        && (!request.resource.data.keys().hasAny(['imageUrl']) || request.resource.data.imageUrl is string)
        && (!request.resource.data.keys().hasAny(['promoStartDate', 'promoEndDate'])
          || (request.resource.data.saleType == 'promo'
            && request.resource.data.keys().hasAll(['promoStartDate', 'promoEndDate'])
            && request.resource.data.promoStartDate is string
            && request.resource.data.promoStartDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.promoEndDate is string
            && request.resource.data.promoEndDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.promoEndDate >= request.resource.data.promoStartDate))
        && request.resource.data.active is bool
        && (!request.resource.data.keys().hasAny(['lastOrderId']) || request.resource.data.lastOrderId is string);
    }
    function validOrder(oid) {
      let product = get(productPath(request.resource.data.productId)).data;
      let productAfter = getAfter(productPath(request.resource.data.productId)).data;
      let productOrder = getAfter(orderPath(productAfter.get('lastOrderId', ''))).data;
      return request.resource.data.keys().hasOnly(['id', 'userId', 'customer', 'phone', 'productId', 'productName', 'productImageUrl', 'quantity', 'total', 'downpayment', 'pickupDate', 'pickupTime', 'status', 'paymentStatus', 'createdAt'])
        && request.resource.data.id == oid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.customer is string
        && request.resource.data.phone is string
        && request.resource.data.productName == product.name
        && (!request.resource.data.keys().hasAny(['productImageUrl'])
          || (request.resource.data.productImageUrl is string
            && request.resource.data.productImageUrl == product.get('imageUrl', '')))
        && request.resource.data.productId is string
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 1
        && request.resource.data.quantity <= 99
        && request.resource.data.total == product.price * request.resource.data.quantity
        && (!request.resource.data.keys().hasAny(['downpayment']) || request.resource.data.downpayment == 0)
        && request.resource.data.pickupDate is string
        && request.resource.data.pickupDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.pickupTime is string
        && request.resource.data.pickupTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.status == 'pending'
        && (!request.resource.data.keys().hasAny(['paymentStatus']) || request.resource.data.paymentStatus == 'unpaid')
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt <= request.time.toMillis()
        && request.resource.data.createdAt >= request.time.toMillis() - 300000
        && product.active == true
        && product.stock >= request.resource.data.quantity
        && productAfter.stock == product.stock - request.resource.data.quantity
        && productAfter.lastOrderId == oid
        && productOrder.userId == request.auth.uid
        && productOrder.productId == request.resource.data.productId
        && productOrder.quantity == request.resource.data.quantity;
    }
    function validStockDeduction(productId) {
      let orderId = request.resource.data.get('lastOrderId', '');
      let orderAfter = getAfter(orderPath(orderId)).data;
      return signedIn()
        && orderId is string
        && orderId.size() > 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'lastOrderId'])
        && resource.data.stock is int
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock
        && orderAfter.userId == request.auth.uid
        && orderAfter.productId == productId
        && orderAfter.status == 'pending'
        && orderAfter.quantity == resource.data.stock - request.resource.data.stock;
    }
    function validOrderUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['status', 'paymentStatus', 'pickupDate', 'pickupTime', 'downpayment', 'deliveredAt'])
        && (resource.data.status != 'delivered' || changed.size() == 0)
        && (!changed.hasAny(['status']) || request.resource.data.status in ['pending', 'ready', 'completed', 'cancelled', 'delivered'])
        && (!changed.hasAny(['paymentStatus']) || request.resource.data.paymentStatus in ['unpaid', 'paid'])
        && (!changed.hasAny(['pickupDate']) || (request.resource.data.pickupDate is string
          && request.resource.data.pickupDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!changed.hasAny(['pickupTime']) || (request.resource.data.pickupTime is string
          && request.resource.data.pickupTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && (!changed.hasAny(['downpayment']) || (request.resource.data.downpayment is number
          && request.resource.data.downpayment >= 0
          && request.resource.data.downpayment <= resource.data.total))
        && (!changed.hasAny(['deliveredAt']) || (request.resource.data.status == 'delivered'
          && request.resource.data.deliveredAt is int))
        && (request.resource.data.status != 'delivered'
          || (request.resource.data.deliveredAt is int
            && (request.resource.data.get('paymentStatus', 'unpaid') == 'paid'
              || request.resource.data.get('downpayment', 0) >= request.resource.data.total)));
    }
    function validCustomerOrderDeletion() {
      let product = get(productPath(resource.data.productId)).data;
      let productAfter = getAfter(productPath(resource.data.productId)).data;
      return signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
        && resource.data.createdAt is int
        && request.time.toMillis() < resource.data.createdAt + 3600000
        && product.stock is int
        && productAfter.stock == product.stock + resource.data.quantity
        && productAfter.lastOrderId == resource.data.id;
    }
    function validStockRestoration(productId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let orderId = request.resource.data.get('lastOrderId', '');
      let orderBefore = get(orderPath(orderId)).data;
      return signedIn()
        && orderId is string
        && request.resource.data.lastOrderId == orderId
        && changed.hasOnly(['stock', 'lastOrderId'])
        && resource.data.stock is int
        && request.resource.data.stock is int
        && orderBefore.userId == request.auth.uid
        && orderBefore.productId == productId
        && orderBefore.status == 'pending'
        && orderBefore.createdAt is int
        && request.time.toMillis() < orderBefore.createdAt + 3600000
        && !existsAfter(orderPath(orderId))
        && request.resource.data.stock == resource.data.stock + orderBefore.quantity;
    }

    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create: if isAdmin() && validProduct();
      allow update: if (isAdmin() && validProduct())
        || validStockDeduction(productId)
        || validStockRestoration(productId);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId && validProfile();
      allow update: if (signedIn() && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'suffix', 'province', 'municipality', 'barangay', 'facebookName', 'phone', 'email', 'role', 'region', 'street']))
        || (isAdmin() && request.auth.uid != userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['user', 'admin']);
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn() && validOrder(orderId);
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin() && validOrderUpdate();
      allow delete: if isAdmin() || validCustomerOrderDeletion();

      match /messages/{messageId} {
        allow read: if canAccessOrderMessages(orderId);
        allow create: if canAccessOrderMessages(orderId)
          && request.resource.data.keys().hasAll(['senderId', 'senderRole', 'text', 'createdAt'])
          && request.resource.data.keys().hasOnly(['senderId', 'senderRole', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderRole == (isAdmin() ? 'admin' : 'customer')
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
